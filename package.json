{
  "name": "leitor-pisca",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.decodificador.json --noEmit && vite build",
    "preview": "vite preview",
    "celular": "vite build && vite preview --host --mode https",
    "test": "vitest run",
    "e2e": "vite build && node e2e/e2e.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.decodificador.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "playwright-core": "^1.49.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
